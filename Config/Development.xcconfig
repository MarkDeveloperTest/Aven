#include "Common.xcconfig"

AVEN_BUNDLE_IDENTIFIER = com.example.aven.dev
AVEN_DISPLAY_NAME = Aven Dev
AVEN_ENVIRONMENT = development
AVEN_FIREBASE_ENVIRONMENT = development
AVEN_FIREBASE_PROJECT_ID = aven-ios-dev-4f7c2
AVEN_URL_SCHEME = aven-dev

DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_NS_ASSERTIONS = YES
ENABLE_TESTABILITY = YES
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1
ONLY_ACTIVE_ARCH = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG AVEN_DEVELOPMENT
SWIFT_COMPILATION_MODE = singlefile
SWIFT_OPTIMIZATION_LEVEL = -Onone

#include? "GoogleSignIn.xcconfig"
#include? "Secrets.xcconfig"
