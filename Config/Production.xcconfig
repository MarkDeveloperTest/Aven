#include "Common.xcconfig"

AVEN_BUNDLE_IDENTIFIER = com.example.aven
AVEN_DISPLAY_NAME = Aven
AVEN_ENVIRONMENT = production
AVEN_FIREBASE_ENVIRONMENT = production
AVEN_FIREBASE_PROJECT_ID =
AVEN_URL_SCHEME = aven
EXCLUDED_SOURCE_FILE_NAMES = GoogleService-Info.plist

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_NS_ASSERTIONS = NO
ENABLE_TESTABILITY = NO
STRIP_INSTALLED_PRODUCT = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS = AVEN_PRODUCTION
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
VALIDATE_PRODUCT = YES

#include? "Secrets.xcconfig"
