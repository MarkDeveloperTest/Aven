rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userIsActive(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.accountState == "active";
    }

    function callerIsActive() {
      return signedIn() && userIsActive(request.auth.uid);
    }

    function relationshipExists(relationshipId) {
      return firestore.exists(
        /databases/(default)/documents/relationships/$(relationshipId)
      );
    }

    function relationshipStatus(relationshipId) {
      return firestore.get(
        /databases/(default)/documents/relationships/$(relationshipId)
      ).data.status;
    }

    function isMember(relationshipId) {
      return callerIsActive()
        && relationshipExists(relationshipId)
        && firestore.exists(
          /databases/(default)/documents/relationships/$(relationshipId)/members/$(request.auth.uid)
        );
    }

    function canReadRelationship(relationshipId) {
      return isMember(relationshipId)
        && relationshipStatus(relationshipId) in ["active", "archived"];
    }

    function canWriteRelationship(relationshipId) {
      return isMember(relationshipId)
        && relationshipStatus(relationshipId) == "active";
    }

    function isImage() {
      return request.resource.contentType.matches("image/(jpeg|png|heic|heif|webp)");
    }

    function isMessageMedia() {
      return request.resource.contentType.matches(
        "(image/(jpeg|png|heic|heif|webp)|video/(mp4|quicktime)|audio/(mpeg|mp4|x-m4a|wav))"
      );
    }

    function isMemoryMedia() {
      return request.resource.contentType.matches(
        "(image/(jpeg|png|heic|heif|webp)|video/(mp4|quicktime))"
      );
    }

    function validOwnerMetadata() {
      return request.resource.metadata.ownerId == request.auth.uid;
    }

    function existingOwnerMetadata() {
      return resource.metadata.ownerId == request.auth.uid;
    }

    function messageOwnedByCaller(relationshipId, messageId) {
      return firestore.exists(
          /databases/(default)/documents/relationships/$(relationshipId)/messages/$(messageId)
        )
        && firestore.get(
          /databases/(default)/documents/relationships/$(relationshipId)/messages/$(messageId)
        ).data.senderId == request.auth.uid;
    }

    function memoryOwnedByCaller(relationshipId, memoryId) {
      return firestore.exists(
          /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
        )
        && firestore.get(
          /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
        ).data.authorId == request.auth.uid;
    }

    function memoryVisibleToCaller(relationshipId, memoryId) {
      return canReadRelationship(relationshipId)
        && firestore.exists(
          /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
        )
        && (
          firestore.get(
            /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
          ).data.surpriseUntil == null
          || firestore.get(
            /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
          ).data.authorId == request.auth.uid
          || (
            firestore.get(
              /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
            ).data.surpriseUntil is timestamp
            && firestore.get(
              /databases/(default)/documents/relationships/$(relationshipId)/memories/$(memoryId)
            ).data.surpriseUntil <= request.time
          )
        );
    }

    function voiceEntryOwnedByCaller(relationshipId, entryId) {
      return firestore.exists(
          /databases/(default)/documents/relationships/$(relationshipId)/voiceJournals/$(entryId)
        )
        && firestore.get(
          /databases/(default)/documents/relationships/$(relationshipId)/voiceJournals/$(entryId)
        ).data.authorId == request.auth.uid;
    }

    match /users/{userId}/profile/{fileId} {
      allow read: if callerIsActive() && request.auth.uid == userId;
      allow create, update: if callerIsActive()
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && isImage();
      allow delete: if callerIsActive() && request.auth.uid == userId;
    }

    match /relationships/{relationshipId}/messages/{messageId}/{fileId} {
      allow read: if canReadRelationship(relationshipId);
      allow create: if canWriteRelationship(relationshipId)
        && messageOwnedByCaller(relationshipId, messageId)
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && isMessageMedia();
      allow update: if canWriteRelationship(relationshipId)
        && messageOwnedByCaller(relationshipId, messageId)
        && existingOwnerMetadata()
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && isMessageMedia();
      allow delete: if canWriteRelationship(relationshipId)
        && messageOwnedByCaller(relationshipId, messageId)
        && existingOwnerMetadata();
    }

    match /relationships/{relationshipId}/memories/{memoryId}/{fileId} {
      allow read: if memoryVisibleToCaller(relationshipId, memoryId);
      allow create: if canWriteRelationship(relationshipId)
        && memoryOwnedByCaller(relationshipId, memoryId)
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && isMemoryMedia();
      allow update: if canWriteRelationship(relationshipId)
        && memoryOwnedByCaller(relationshipId, memoryId)
        && existingOwnerMetadata()
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && isMemoryMedia();
      allow delete: if canWriteRelationship(relationshipId)
        && memoryOwnedByCaller(relationshipId, memoryId)
        && existingOwnerMetadata();
    }

    match /relationships/{relationshipId}/voice/{entryId}/{fileId} {
      allow read: if canReadRelationship(relationshipId);
      allow create: if canWriteRelationship(relationshipId)
        && voiceEntryOwnedByCaller(relationshipId, entryId)
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches("audio/(mpeg|mp4|x-m4a|wav)");
      allow update: if false;
      allow delete: if canWriteRelationship(relationshipId)
        && voiceEntryOwnedByCaller(relationshipId, entryId)
        && existingOwnerMetadata();
    }

    match /relationships/{relationshipId}/covers/{fileId} {
      allow read: if canReadRelationship(relationshipId);
      allow create: if canWriteRelationship(relationshipId)
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && isImage();
      allow update: if canWriteRelationship(relationshipId)
        && existingOwnerMetadata()
        && validOwnerMetadata()
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && isImage();
      allow delete: if canWriteRelationship(relationshipId)
        && existingOwnerMetadata();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
