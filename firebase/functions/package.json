{
  "name": "aven-firebase-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck:test && npm run test:unit",
    "test:unit": "vitest run test/unit --maxWorkers=1 --pool=threads",
    "test:rules:run": "vitest run test/rules --maxWorkers=1 --pool=threads",
    "test:rules": "firebase emulators:exec --project demo-aven-local --config ../firebase.json --only firestore,storage \"npm run test:rules:run\"",
    "test:emulator:run": "vitest run test/emulator --maxWorkers=1 --pool=threads",
    "test:emulator": "firebase emulators:exec --project demo-aven-local --config ../firebase.json --only firestore \"npm run test:emulator:run\""
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "uuid": "11.1.1"
  }
}
